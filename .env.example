# Copy this file to .env and enter your API key.
DEEPSEEK_API_KEY=

# Optional: leave blank to use DEEPSEEK_API_KEY for vision too.
DEEPSEEK_VISION_API_KEY=

# DeepSeek OpenAI-compatible chat completions endpoint.
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_CHAT_MODEL=deepseek-flash

# Uses the same DeepSeek endpoint and key by default.
DEEPSEEK_VISION_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_VISION_MODEL=deepseek-flash

# Select "deepseek" for image API calls, or "opencv" for local detection.
VISION_BACKEND=deepseek
